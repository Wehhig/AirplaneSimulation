@{
    ViewData["Title"] = "Airport Control Simulator";
}

<div class="airport-page">
    <div class="airport-top">
        <div>
            <h1>Airport Control Simulator</h1>
            <p>Live airport simulation with SignalR updates</p>
        </div>

        <div class="airport-buttons">
            <button onclick="startSimulation()">Start</button>
            <button onclick="stopSimulation()">Stop</button>
            <button onclick="resetSimulation()">Reset</button>
            <button onclick="addPlane()">Add Plane</button>
        </div>
    </div>

    <div class="tabs">
        <button id="simulation-tab" class="tab-button active" onclick="showTab('simulation')">Simulation</button>
        <button id="admin-tab" class="tab-button" onclick="showTab('admin')">Admin / Data</button>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <span>Running</span>
            <strong id="stat-running">-</strong>
        </div>
        <div class="stat-card">
            <span>Runways</span>
            <strong id="stat-runways">-</strong>
        </div>
        <div class="stat-card">
            <span>In air</span>
            <strong id="stat-air">-</strong>
        </div>
        <div class="stat-card">
            <span>Waiting</span>
            <strong id="stat-waiting">-</strong>
        </div>
        <div class="stat-card">
            <span>Landing</span>
            <strong id="stat-landing">-</strong>
        </div>
        <div class="stat-card">
            <span>Served</span>
            <strong id="stat-served">-</strong>
        </div>
    </div>

    <div id="simulation-view" class="tab-content active">
        <div class="simulation-grid">
            <div class="panel">
                <div class="panel-title-row">
                    <h2>Airport live view</h2>
                    <span id="airport-status-pill" class="status-pill">Idle</span>
                </div>

                <div class="airport-map">
                    <svg class="airport-svg" viewBox="0 0 900 480" preserveAspectRatio="xMidYMid meet">
                        <rect x="0" y="0" width="900" height="480" rx="14" class="map-bg" />
                        <ellipse cx="270" cy="110" rx="170" ry="70" class="holding-line" />
                        <text x="270" y="115" text-anchor="middle" class="map-text">HOLDING AREA</text>

                        <path d="M 430 110 C 620 130 780 175 815 240" class="route-line" />
                        <path d="M 250 170 C 320 210 380 235 430 250" class="route-line" />

                        <rect x="220" y="235" width="500" height="66" rx="4" class="runway" />
                        <line x1="245" y1="268" x2="695" y2="268" class="runway-center" />
                        <text x="735" y="257" class="map-text">RUNWAY 1</text>
                        <text x="735" y="288" class="map-text">RUNWAY 2</text>

                        <line x1="370" y1="301" x2="370" y2="355" class="taxi-line" />
                        <line x1="470" y1="301" x2="470" y2="355" class="taxi-line" />
                        <line x1="570" y1="301" x2="570" y2="355" class="taxi-line" />

                        <rect x="300" y="355" width="70" height="45" rx="4" class="gate" />
                        <rect x="430" y="355" width="70" height="45" rx="4" class="gate" />
                        <rect x="560" y="355" width="70" height="45" rx="4" class="gate" />
                        <text x="335" y="383" text-anchor="middle" class="map-text-small">GATE 1</text>
                        <text x="465" y="383" text-anchor="middle" class="map-text-small">GATE 2</text>
                        <text x="595" y="383" text-anchor="middle" class="map-text-small">GATE 3</text>

                        <rect x="260" y="405" width="420" height="52" rx="6" class="terminal" />
                        <text x="470" y="438" text-anchor="middle" class="terminal-text">TERMINAL</text>
                    </svg>

                    <div id="plane-layer" class="plane-layer"></div>
                </div>
            </div>

            <div class="panel">
                <h2>Current state</h2>

                <div class="state-list">
                    <div>
                        <span>Active planes</span>
                        <strong id="state-active">0</strong>
                    </div>
                    <div>
                        <span>At gate</span>
                        <strong id="state-gate">0</strong>
                    </div>
                    <div>
                        <span>Taking off</span>
                        <strong id="state-takingoff">0</strong>
                    </div>
                    <div>
                        <span>Departed</span>
                        <strong id="state-departed">0</strong>
                    </div>
                </div>

                <h2>Recent events</h2>
                <div id="recent-log" class="event-log small-log"></div>
            </div>
        </div>
    </div>

    <div id="admin-view" class="tab-content">
        <div class="airport-layout">
            <div class="panel">
                <h2>Planes</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Flight</th>
                            <th>Status</th>
                            <th>Runway</th>
                            <th>Gate</th>
                            <th>Updated</th>
                        </tr>
                    </thead>
                    <tbody id="planes-table"></tbody>
                </table>
            </div>

            <div class="panel">
                <h2>Event log</h2>
                <div id="event-log" class="event-log"></div>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script src="~/js/airport.js" asp-append-version="true"></script>
